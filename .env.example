# Base URL of the worktide backend API the portal talks to.
# Dev (local ddev backend): the worktide API host.
# Prod: the portal is served on its own domain; point this at the public API.
VITE_API_BASE=/v1

# Mercure hub URL for live notifications (bell + Benachrichtigungen page).
# Dev: a same-origin path (`/.well-known/mercure`) proxied by Vite to the hub
# (see vite.config.ts) so the SSE stream dodges the shared hub's CORS allowlist.
# Prod: point straight at the hub, e.g.
#   VITE_MERCURE_HUB_URL=https://worktide-mercure.example.com/.well-known/mercure
# (the hub's cors_origins must then list the real portal domain).
VITE_MERCURE_HUB_URL=/.well-known/mercure

# --- Dev-only proxy/server overrides (vite.config.ts) --------------------------
# The dev server derives its hosts from DDEV_SITENAME, so the base "worktide"
# instance and any ddev white-label (e.g. worktide-intewa) work with no config.
# Override individually in a gitignored .env.local only when a host deviates:
#   VITE_DEV_PORTAL_HOST=<sitename>-portal.ddev.site   # HMR wss host
#   VITE_DEV_API_TARGET=https://api.<sitename>.ddev.site   # /v1 proxy target
#   VITE_DEV_MERCURE_TARGET=https://worktide-mercure.wappler.systems  # SSE hub
# Mercure has no sitename pattern (shared external hub upstream), so local
# instances that run their own ddev mercure service must set it explicitly.
